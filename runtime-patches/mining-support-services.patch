+// Read-only reach from the SAME fitted/charge/skill/effect/implant/burst/system
+// snapshot as activation. No target probe, resource mutation or grace distance.
+function readEntityMiningReach(entity, moduleItem, nowMs) {
+  const characterID = resolveEntityCharacterID(entity);
+  const shipItem = characterID > 0 ? getActiveShipRecord(characterID) : null;
+  if (!shipItem || shipItem.itemID !== entity.itemID || !moduleItem || moduleItem.locationID !== entity.itemID
+    || moduleItem.ownerID !== characterID || !Number.isFinite(nowMs)) return null;
+  const fitted = resolveEntityModuleItem(entity, moduleItem.itemID);
+  if (!fitted || fitted.typeID !== moduleItem.typeID) return null;
+  const effectRecord = findMiningEffectRecordForModule(fitted);
+  if (!effectRecord) return { matched: false };
+  const snapshot = buildEntityMiningSnapshot(entity, fitted, effectRecord, { nowMs });
+  if (!snapshot || !Number.isFinite(snapshot.maxRangeMeters) || snapshot.maxRangeMeters < 0) return { matched: true, availability: "unknown" };
+  return { matched: true, availability: "available", maxRangeMeters: snapshot.maxRangeMeters, resourceFamily: snapshot.family };
+}
