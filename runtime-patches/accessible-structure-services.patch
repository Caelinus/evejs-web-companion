diff --git a/server/src/services/structure/structureDirectoryService.js b/server/src/services/structure/structureDirectoryService.js
--- a/server/src/services/structure/structureDirectoryService.js
+++ b/server/src/services/structure/structureDirectoryService.js
@@ -475,3 +475,25 @@ class StructureDirectoryService extends BaseService {
+  // An access-scoped capability read for docked clients. Return service IDs
+  // only: operational structure state (fuel, timers and vulnerability) must
+  // not leak through a public destination or station-panel request.
+  Handle_GetMyAccessibleStructureServices(args, session) {
+    const structureID = normalizePositiveInt(Array.isArray(args) ? args[0] : null, 0);
+    const structure = structureID > 0 ? structureState.getStructureByID(structureID) : null;
+    if (!structure || !structureState.canCharacterDockAtStructure(session, structure).success) {
+      return buildIDList([]);
+    }
+    const serviceIDs = [
+      STRUCTURE_SERVICE_ID.DOCKING,
+      STRUCTURE_SERVICE_ID.FITTING,
+      STRUCTURE_SERVICE_ID.OFFICES,
+      STRUCTURE_SERVICE_ID.REPROCESSING,
+      STRUCTURE_SERVICE_ID.MARKET,
+      STRUCTURE_SERVICE_ID.REPAIR,
+      STRUCTURE_SERVICE_ID.INDUSTRY,
+    ];
+    return buildIDList(serviceIDs.filter((serviceID) =>
+      characterHasStructureService(session, structure, serviceID)));
+  }
+
   Handle_GetStructures(args, session, kwargs) {
     const structures = listRequestedStructures(args);
     log.debug(`[StructureDirectoryService] GetStructures count=${structures.length}`);
